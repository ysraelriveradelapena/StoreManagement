@using StoreManagement.Web.DTOs.Users
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText>
                Set a new password for <b>@UserEmail</b>.
            </MudText>

            <MudForm @ref="_form">
                <MudTextField T="string"
                              Label="New Password"
                              @bind-Value="_password"
                              InputType="InputType.Password"
                              Required="true"
                              RequiredError="Password is required."
                              Validation="@(new Func<string, IEnumerable<string>>(ValidatePassword))" />

                <MudTextField T="string"
                              Label="Confirm Password"
                              @bind-Value="_confirmPassword"
                              InputType="InputType.Password"
                              Required="true"
                              RequiredError="Please confirm the password." />
            </MudForm>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save">
            Reset Password
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string UserEmail { get; set; } = string.Empty;

    private MudForm _form = default!;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;

    private IEnumerable<string> ValidatePassword(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
            yield return "Password is required.";
        else if (password.Length < 6)
            yield return "Password must contain at least 6 characters.";
    }

    private async Task Save()
    {
        await _form.Validate();

        if (!_form.IsValid)
            return;

        if (_password != _confirmPassword)
        {
            Snackbar.Add("Passwords do not match.", Severity.Error);
            return;
        }

        MudDialog.Close(DialogResult.Ok(
            new ResetUserPasswordRequest
            {
                NewPassword = _password
            }));
    }

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    private void Cancel() => MudDialog.Cancel();
}
