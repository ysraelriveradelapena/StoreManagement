
@page "/products/variants/{ProductVariantId:int}/prices"

@using MudBlazor
@using StoreManagement.Web.DTOs.ProductVariants
@using PriceDto = StoreManagement.Web.DTOs.ProductVariantPrices.ProductVariantPriceDto
@using StoreManagement.Web.DTOs.ProductVariantPrices
@using StoreManagement.Web.Services
@using StoreManagement.Web.Components.Dialogs.ProductVariantPrices

@inject ApiService ApiService
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudPaper Class="pa-4">

        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween"
                  Class="mb-4">

            <MudStack Spacing="1">
                <MudText Typo="Typo.h5">Product Variant Prices</MudText>

                @if (_variant is not null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        SKU: @_variant.SKU
                        @if (!string.IsNullOrWhiteSpace(_variant.VariantName))
                        {
                            <text> — @_variant.VariantName</text>
                        }
                    </MudText>
                }
            </MudStack>

            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="BackToVariants">
                    Back
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@(_variant is null || !_variant.IsActive)"
                           OnClick="AddPrice">
                    Add Price
                </MudButton>
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(_pageError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                @_pageError
            </MudAlert>
        }

        <MudTextField T="string"
                      @bind-Value="_search"
                      Placeholder="Search by price type..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Clearable="true"
                      Class="mb-4" />

        <MudTable Items="@FilteredPrices"
                  Loading="_loading"
                  Hover="true"
                  Dense="true"
                  Striped="true">

            <HeaderContent>
                <MudTh>Price Type</MudTh>
                <MudTh>Price</MudTh>
                <MudTh>Effective From</MudTh>
                <MudTh>Effective To</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Price Type">@context.PriceType</MudTd>

                <MudTd DataLabel="Price">
                    @context.Price.ToString("N2")
                </MudTd>

                <MudTd DataLabel="Effective From">
                    @context.EffectiveFrom.ToString("yyyy-MM-dd")
                </MudTd>

                <MudTd DataLabel="Effective To">
                    @(context.EffectiveTo.HasValue
                                        ? context.EffectiveTo.Value.ToString("yyyy-MM-dd")
                                        : "No end date")
                </MudTd>

                <MudTd DataLabel="Status">
                    <MudChip T="string"
                             Color="@(context.IsActive ? Color.Success : Color.Default)"
                             Size="Size.Small">
                        @(context.IsActive ? "Active" : "Inactive")
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Actions">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Title="Edit price"
                                   OnClick="@(() => EditPrice(context))" />

                    <MudIconButton Icon="@(context.IsActive
                                                                            ? Icons.Material.Filled.Block
                                                                            : Icons.Material.Filled.CheckCircle)"
                                   Color="@(context.IsActive
                                                                            ? Color.Error
                                                                            : Color.Success)"
                                   Size="Size.Small"
                                   Title="@(context.IsActive
                                                                            ? "Deactivate"
                                                                            : "Activate")"
                                   OnClick="@(() => ToggleStatus(context))" />
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText Class="pa-4">No prices found for this variant.</MudText>
            </NoRecordsContent>

        </MudTable>

        <MudButton Class="mt-4"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadPrices">
            Refresh
        </MudButton>

    </MudPaper>
</MudContainer>

@code {
    [Parameter]
    public int ProductVariantId { get; set; }

    private ProductVariantDto? _variant;
    private List<PriceDto> _prices = new();
    private string _search = string.Empty;
    private bool _loading;
    private string? _pageError;

    private IEnumerable<PriceDto> FilteredPrices =>
        _prices.Where(x =>
            string.IsNullOrWhiteSpace(_search) ||
            x.PriceType.Contains(
                _search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await AuthState.InitializeAsync();

        if (string.IsNullOrWhiteSpace(AuthState.Token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadVariant();
        await LoadPrices();

        StateHasChanged();
    }

    private async Task LoadVariant()
    {
        try
        {
            _variant = await ApiService.GetAsync<ProductVariantDto>(
                $"api/product-variants/{ProductVariantId}");

            if (_variant is null)
            {
                _pageError = "Product variant not found.";
            }
        }
        catch (Exception ex)
        {
            _pageError = $"Failed to load product variant: {ex.Message}";
        }
    }

    private async Task LoadPrices()
    {
        try
        {
            _loading = true;
            _pageError = null;

            var result = await ApiService.GetAsync<List<PriceDto>>(
                $"api/product-variant-prices?includeInactive=true&productVariantId={ProductVariantId}");

            _prices = result ?? new List<PriceDto>();
        }
        catch (Exception ex)
        {
            _pageError = $"Failed to load prices: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddPrice()
    {
        if (_variant is null)
            return;

        var parameters = new DialogParameters<ProductVariantPriceDialog>
        {
            { x => x.ProductVariantId, ProductVariantId },
            { x => x.SKU, _variant.SKU },
            { x => x.VariantName, _variant.VariantName }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ProductVariantPriceDialog>(
            "Add Price", parameters, options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await LoadPrices();
    }

    private async Task EditPrice(PriceDto price)
    {
        if (_variant is null)
            return;

        var parameters = new DialogParameters<ProductVariantPriceDialog>
        {
            { x => x.ProductVariantId, ProductVariantId },
            { x => x.SKU, _variant.SKU },
            { x => x.VariantName, _variant.VariantName },
            { x => x.PriceRecord, price }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ProductVariantPriceDialog>(
            "Edit Price", parameters, options);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await LoadPrices();
    }

    private async Task ToggleStatus(PriceDto price)
    {
        var newStatus = !price.IsActive;
        var action = newStatus ? "activate" : "deactivate";

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to {action} the {price.PriceType} price for SKU '{price.SKU}'?");

        if (!confirmed)
            return;

        try
        {
            var response = await ApiService.PatchAsync(
                $"api/product-variant-prices/{price.Id}/status",
                new UpdateProductVariantPriceStatusRequest
                {
                    IsActive = newStatus
                });

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    $"Price {action}d successfully.",
                    Severity.Success);

                await LoadPrices();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    $"Failed to change price status: {error}",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Failed to change price status: {ex.Message}",
                Severity.Error);
        }
    }

    private void BackToVariants()
    {
        Navigation.NavigateTo(
            $"/products/{_variant?.ProductId}/variants");
    }
}
