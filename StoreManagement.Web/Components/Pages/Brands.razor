@page "/brands"

@using MudBlazor
@using Microsoft.JSInterop
@using StoreManagement.Web.DTOs.Brands
@using StoreManagement.Web.Services
@using StoreManagement.Web.Components.Dialogs.Brands

@inject ApiService ApiService
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    <MudText Typo="Typo.h4" Class="mb-1">
        Brand Maintenance
    </MudText>

    <MudText Typo="Typo.body2"
             Color="Color.Secondary"
             Class="mb-4">
        Manage the brands assigned to your products.
    </MudText>

    <MudPaper Elevation="2" Class="pa-4">

        @* HEADER *@
        <MudStack Row="true"
                  FlexWrap="Wrap"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween"
                  Class="mb-4">

            <MudText Typo="Typo.h6">
                Brands
            </MudText>

            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Spacing="2">

                <MudText Typo="Typo.body2">
                    Total: @_brands.Count
                </MudText>

                <MudButton Variant="MudBlazor.Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Disabled="_loading"
                           OnClick="OpenAddBrandDialog">
                    Add Brand
                </MudButton>

            </MudStack>

        </MudStack>

        @* SEARCH *@
        <MudTextField T="string"
                      @bind-Value="_searchText"
                      Label="Search brand"
                      Placeholder="Enter brand name..."
                      Variant="MudBlazor.Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Clearable="true"
                      Class="mb-4" />

        @* ERROR *@
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                @_errorMessage
            </MudAlert>
        }

        @* BRAND TABLE *@
        <MudTable Items="@FilteredBrands"
                  Loading="_loading"
                  Hover="true"
                  Striped="true"
                  Dense="true"
                  Elevation="0">

            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Brand Name</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Last Updated</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>

            <RowTemplate>

                <MudTd DataLabel="ID">
                    @context.Id
                </MudTd>

                <MudTd DataLabel="Brand Name">
                    @context.Name
                </MudTd>

                <MudTd DataLabel="Status">

                    @if (context.IsActive)
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Size="Size.Small">
                            Active
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Default"
                                 Size="Size.Small">
                            Inactive
                        </MudChip>
                    }

                </MudTd>

                <MudTd DataLabel="Created">
                    @context.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")
                </MudTd>

                <MudTd DataLabel="Last Updated">
                    @(context.UpdatedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                </MudTd>

                @* ACTION BUTTONS *@
                <MudTd DataLabel="Actions">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="1">

                        @* EDIT *@
                        <MudTooltip Text="Edit Brand">

                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Disabled="_loading"
                                           OnClick="@(() => OpenEditBrandDialog(context))" />

                        </MudTooltip>

                        @* ACTIVATE / DEACTIVATE *@
                        <MudTooltip Text="@(context.IsActive ? "Deactivate" : "Activate")">

                            <MudIconButton Icon="@(context.IsActive
                                                                                               ? Icons.Material.Filled.Block
                                                                                               : Icons.Material.Filled.CheckCircle)"
                                           Color="@(context.IsActive
                                                                                               ? Color.Error
                                                                                               : Color.Success)"
                                           Size="Size.Small"
                                           Disabled="_loading"
                                           OnClick="@(() => ToggleBrandStatusAsync(context))" />

                        </MudTooltip>

                    </MudStack>

                </MudTd>

            </RowTemplate>

            <NoRecordsContent>
                <MudText Class="pa-4">
                    No brands found.
                </MudText>
            </NoRecordsContent>

        </MudTable>

        @* REFRESH *@
        <MudStack Row="true"
                  Justify="Justify.FlexEnd"
                  Class="mt-4">

            <MudButton Variant="MudBlazor.Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadBrandsAsync"
                       Disabled="_loading">
                Refresh
            </MudButton>

        </MudStack>

    </MudPaper>

</MudContainer>

@code {

    private List<BrandDto> _brands = new();

    private string _searchText = string.Empty;

    private bool _loading;

    private string? _errorMessage;

    private IEnumerable<BrandDto> FilteredBrands =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _brands
            : _brands.Where(b =>
                b.Name.Contains(
                    _searchText,
                    StringComparison.OrdinalIgnoreCase));

    // INITIAL LOAD
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await AuthState.InitializeAsync();

        if (!AuthState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadBrandsAsync();

        StateHasChanged();
    }

    // LOAD BRANDS
    private async Task LoadBrandsAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var result = await ApiService.GetAsync<List<BrandDto>>(
                "api/brands?includeInactive=true");

            _brands = result ?? new List<BrandDto>();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load brands: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    // ADD BRAND
    private async Task OpenAddBrandDialog()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AddBrandDialog>(
            "Add Brand",
            options);

        var result = await dialog.Result;

        if (result is null ||
            result.Canceled ||
            result.Data is not CreateBrandRequest request)
        {
            return;
        }

        _loading = true;

        try
        {
            var response = await ApiService.PostAsync(
                "api/brands",
                request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    "Brand created successfully.",
                    Severity.Success);

                await LoadBrandsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    $"Failed to create brand. HTTP {(int)response.StatusCode}: {error}",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Error creating brand: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // EDIT BRAND
    private async Task OpenEditBrandDialog(BrandDto brand)
    {
        var parameters = new DialogParameters
        {
            ["Brand"] = brand
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AddBrandDialog>(
            "Edit Brand",
            parameters,
            options);

        var result = await dialog.Result;

        if (result is null ||
            result.Canceled ||
            result.Data is not CreateBrandRequest request)
        {
            return;
        }

        _loading = true;

        try
        {
            var response = await ApiService.PutAsync(
                $"api/brands/{brand.Id}",
                request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    "Brand updated successfully.",
                    Severity.Success);

                await LoadBrandsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    $"Failed to update brand. HTTP {(int)response.StatusCode}: {error}",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Error updating brand: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ACTIVATE / DEACTIVATE BRAND
    private async Task ToggleBrandStatusAsync(BrandDto brand)
    {
        var newStatus = !brand.IsActive;

        var action = newStatus
            ? "activate"
            : "deactivate";

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to {action} brand '{brand.Name}'?");

        if (!confirmed)
            return;

        _loading = true;

        try
        {
            var response = await ApiService.PatchAsync(
                $"api/brands/{brand.Id}/status",
                new
                {
                    IsActive = newStatus
                });

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    newStatus
                        ? "Brand activated successfully."
                        : "Brand deactivated successfully.",
                    Severity.Success);

                await LoadBrandsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    $"Failed to update brand status. HTTP {(int)response.StatusCode}: {error}",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Error updating brand status: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
