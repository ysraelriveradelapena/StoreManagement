@page "/categories"

@using MudBlazor
@using Microsoft.JSInterop
@using StoreManagement.Web.DTOs.Categories
@using StoreManagement.Web.Services
@using StoreManagement.Web.Components.Dialogs.Categories

@inject ApiService ApiService
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    <MudText Typo="Typo.h4" Class="mb-1">
        Category Maintenance
    </MudText>

    <MudText Typo="Typo.body2"
             Color="Color.Secondary"
             Class="mb-4">
        Manage product categories.
    </MudText>

    <MudPaper Elevation="2" Class="pa-4">

        @* HEADER *@
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween"
                  Class="mb-4">

            <MudText Typo="Typo.h6">
                Categories
            </MudText>

            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Spacing="2">

                <MudText Typo="Typo.body2">
                    Total: @_categories.Count
                </MudText>

                <MudButton Variant="MudBlazor.Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Disabled="_loading"
                           OnClick="OpenAddCategoryDialog">
                    Add Category
                </MudButton>

            </MudStack>

        </MudStack>

        @* SEARCH *@
        <MudTextField T="string"
                      @bind-Value="_searchText"
                      Label="Search category"
                      Placeholder="Enter category name..."
                      Variant="MudBlazor.Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Clearable="true"
                      Class="mb-4" />

        @* ERROR *@
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                @_errorMessage
            </MudAlert>
        }

        @* CATEGORY TABLE *@
        <MudTable Items="@FilteredCategories"
                  Loading="_loading"
                  Hover="true"
                  Striped="true"
                  Dense="true"
                  Elevation="0">

            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Category Name</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Last Updated</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>

            <RowTemplate>

                <MudTd DataLabel="ID">
                    @context.Id
                </MudTd>

                <MudTd DataLabel="Category Name">
                    @context.Name
                </MudTd>

                <MudTd DataLabel="Status">

                    @if (context.IsActive)
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Size="Size.Small">
                            Active
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Default"
                                 Size="Size.Small">
                            Inactive
                        </MudChip>
                    }

                </MudTd>

                <MudTd DataLabel="Created">
                    @context.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")
                </MudTd>

                <MudTd DataLabel="Last Updated">
                    @(context.UpdatedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                </MudTd>

                @* SAME ACTION BUTTONS AS BRANDS *@
                <MudTd DataLabel="Actions">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="1">

                        @* EDIT *@
                        <MudTooltip Text="Edit Category">

                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Disabled="_loading"
                                           OnClick="@(() => OpenEditCategoryDialog(context))" />

                        </MudTooltip>

                        @* ACTIVATE / DEACTIVATE *@
                        <MudTooltip Text="@(context.IsActive ? "Deactivate" : "Activate")">

                            <MudIconButton Icon="@(context.IsActive
                                                                                               ? Icons.Material.Filled.Block
                                                                                               : Icons.Material.Filled.CheckCircle)"
                                           Color="@(context.IsActive
                                                                                               ? Color.Error
                                                                                               : Color.Success)"
                                           Size="Size.Small"
                                           Disabled="_loading"
                                           OnClick="@(() => ToggleCategoryStatusAsync(context))" />

                        </MudTooltip>

                    </MudStack>

                </MudTd>

            </RowTemplate>

            <NoRecordsContent>
                <MudText Class="pa-4">
                    No categories found.
                </MudText>
            </NoRecordsContent>

        </MudTable>

        @* REFRESH *@
        <MudStack Row="true"
                  Justify="Justify.FlexEnd"
                  Class="mt-4">

            <MudButton Variant="MudBlazor.Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadCategoriesAsync"
                       Disabled="_loading">
                Refresh
            </MudButton>

        </MudStack>

    </MudPaper>

</MudContainer>

@code {

    private List<CategoryDto> _categories = new();

    private string _searchText = string.Empty;

    private bool _loading;

    private string? _errorMessage;

    private IEnumerable<CategoryDto> FilteredCategories =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _categories
            : _categories.Where(c =>
                c.Name.Contains(
                    _searchText,
                    StringComparison.OrdinalIgnoreCase));

    // INITIAL LOAD
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await AuthState.InitializeAsync();

        if (!AuthState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadCategoriesAsync();

        StateHasChanged();
    }

    // LOAD CATEGORIES
    private async Task LoadCategoriesAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var result = await ApiService.GetAsync<List<CategoryDto>>(
                "api/categories?includeInactive=true");

            _categories = result ?? new List<CategoryDto>();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load categories: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    // ADD CATEGORY
    private async Task OpenAddCategoryDialog()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AddCategoryDialog>(
            "Add Category",
            options);

        var result = await dialog.Result;

        if (result is null ||
            result.Canceled ||
            result.Data is not CreateCategoryRequest request)
        {
            return;
        }

        _loading = true;

        try
        {
            var response = await ApiService.PostAsync(
                "api/categories",
                request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    "Category created successfully.",
                    Severity.Success);

                await LoadCategoriesAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    $"Failed to create category. HTTP {(int)response.StatusCode}: {error}",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Error creating category: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // EDIT CATEGORY
    private async Task OpenEditCategoryDialog(CategoryDto category)
    {
        var parameters = new DialogParameters
        {
            ["Category"] = category
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AddCategoryDialog>(
            "Edit Category",
            parameters,
            options);

        var result = await dialog.Result;

        if (result is null ||
            result.Canceled ||
            result.Data is not CreateCategoryRequest request)
        {
            return;
        }

        _loading = true;

        try
        {
            var response = await ApiService.PutAsync(
                $"api/categories/{category.Id}",
                request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    "Category updated successfully.",
                    Severity.Success);

                await LoadCategoriesAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    $"Failed to update category. HTTP {(int)response.StatusCode}: {error}",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Error updating category: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ACTIVATE / DEACTIVATE CATEGORY
    private async Task ToggleCategoryStatusAsync(CategoryDto category)
    {
        var newStatus = !category.IsActive;

        var action = newStatus
            ? "activate"
            : "deactivate";

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to {action} category '{category.Name}'?");

        if (!confirmed)
            return;

        _loading = true;

        try
        {
            var response = await ApiService.PatchAsync(
                $"api/categories/{category.Id}/status",
                new
                {
                    IsActive = newStatus
                });

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    newStatus
                        ? "Category activated successfully."
                        : "Category deactivated successfully.",
                    Severity.Success);

                await LoadCategoriesAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    $"Failed to update category status. HTTP {(int)response.StatusCode}: {error}",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Error updating category status: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
