@page "/stores"

@using MudBlazor
@using StoreManagement.Web.DTOs.Stores
@using StoreManagement.Web.Services
@using StoreManagement.Web.Components.Dialogs.Stores

@inject ApiService ApiService
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">

    <MudText Typo="Typo.h4" Class="mb-1">
        Store Maintenance
    </MudText>

    <MudText Typo="Typo.body2"
             Color="Color.Secondary"
             Class="mb-4">
        Manage stores, department stores, and locations.
    </MudText>

    <MudPaper Elevation="2" Class="pa-4">

        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween"
                  Class="mb-4">

            <MudText Typo="Typo.h6">Stores</MudText>

            <MudStack Row="true"
                      AlignItems="AlignItems.Center"
                      Spacing="2">

                <MudText Typo="Typo.body2">
                    Total: @_stores.Count
                </MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddStoreDialog">
                    Add Store
                </MudButton>

            </MudStack>
        </MudStack>

        <MudTextField T="string"
                      @bind-Value="_searchText"
                      Label="Search stores"
                      Placeholder="Code, name, department, or location..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Class="mb-4" />

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                @_errorMessage
            </MudAlert>
        }

        <MudTable Items="@FilteredStores"
                  Loading="_loading"
                  Hover="true"
                  Striped="true"
                  Dense="true"
                  Elevation="0">

            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Store Code</MudTh>
                <MudTh>Store Name</MudTh>
                <MudTh>Department Store</MudTh>
                <MudTh>Location</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Last Updated</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="ID">
                    @context.Id
                </MudTd>

                <MudTd DataLabel="Store Code">
                    @context.StoreCode
                </MudTd>

                <MudTd DataLabel="Store Name">
                    @context.StoreName
                </MudTd>

                <MudTd DataLabel="Department Store">
                    @(context.DepartmentStore ?? "—")
                </MudTd>

                <MudTd DataLabel="Location">
                    @(context.Location ?? "—")
                </MudTd>

                <MudTd DataLabel="Status">
                    @if (context.IsActive)
                    {
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Size="Size.Small">
                            Active
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string"
                                 Color="Color.Default"
                                 Size="Size.Small">
                            Inactive
                        </MudChip>
                    }
                </MudTd>

                <MudTd DataLabel="Created">
                    @context.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")
                </MudTd>

                <MudTd DataLabel="Last Updated">
                    @(context.UpdatedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                </MudTd>

                <MudTd DataLabel="Actions">
                    <MudStack Row="true" Spacing="1">

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Title="Edit store"
                                       Disabled="_loading"
                                       OnClick="@(() => OpenEditStoreDialog(context))" />

                        <MudIconButton Icon="@(context.IsActive
                                                                  ? Icons.Material.Filled.Block
                                                                  : Icons.Material.Filled.CheckCircle)"
                                       Color="@(context.IsActive
                                                                  ? Color.Error
                                                                  : Color.Success)"
                                       Size="Size.Small"
                                       Title="@(context.IsActive
                                                                  ? "Deactivate store"
                                                                  : "Activate store")"
                                       Disabled="_loading"
                                       OnClick="@(() => ToggleStoreStatusAsync(context))" />

                    </MudStack>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText Class="pa-4">
                    No stores found.
                </MudText>
            </NoRecordsContent>

        </MudTable>

        <MudStack Row="true"
                  Justify="Justify.FlexEnd"
                  Class="mt-4">

            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadStoresAsync"
                       Disabled="_loading">
                Refresh
            </MudButton>

        </MudStack>

    </MudPaper>

</MudContainer>

@code {
    private List<StoreDto> _stores = new();
    private string _searchText = "";
    private bool _loading;
    private string? _errorMessage;

    private IEnumerable<StoreDto> FilteredStores =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _stores
            : _stores.Where(s =>
                s.StoreCode.Contains(
                    _searchText, StringComparison.OrdinalIgnoreCase) ||
                s.StoreName.Contains(
                    _searchText, StringComparison.OrdinalIgnoreCase) ||
                (s.DepartmentStore?.Contains(
                    _searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (s.Location?.Contains(
                    _searchText, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await AuthState.InitializeAsync();

        if (AuthState.IsLoggedIn)
        {
            await LoadStoresAsync();
            StateHasChanged();
        }
        else
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async Task LoadStoresAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var result =
                await ApiService.GetAsync<List<StoreDto>>(
                    "api/stores?includeInactive=true");

            _stores = result ?? new List<StoreDto>();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load stores: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenAddStoreDialog()
    {
        await OpenStoreDialogAsync(null);
    }

    private async Task OpenEditStoreDialog(StoreDto store)
    {
        await OpenStoreDialogAsync(store);
    }

    private async Task OpenStoreDialogAsync(StoreDto? store)
    {
        var parameters = new DialogParameters
        {
            { "Store", store }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<StoreDialog>(
            store is null ? "Add Store" : "Edit Store",
            parameters,
            options);

        var result = await dialog.Result;

        if (result is null ||
            result.Canceled ||
            result.Data is not StoreRequest request)
        {
            return;
        }

        try
        {
            HttpResponseMessage response;

            if (store is null)
            {
                response = await ApiService.PostAsync(
                    "api/stores",
                    request);
            }
            else
            {
                response = await ApiService.PutAsync(
                    $"api/stores/{store.Id}",
                    request);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    store is null
                        ? "Store created successfully."
                        : "Store updated successfully.",
                    Severity.Success);

                await LoadStoresAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    $"Failed to save store. HTTP {(int)response.StatusCode}: {error}",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Error saving store: {ex.Message}",
                Severity.Error);
        }
    }

    private async Task ToggleStoreStatusAsync(StoreDto store)
    {
        var newStatus = !store.IsActive;

        try
        {
            var response = await ApiService.PatchAsync(
                $"api/stores/{store.Id}/status",
                new { IsActive = newStatus });

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    newStatus
                        ? "Store activated successfully."
                        : "Store deactivated successfully.",
                    Severity.Success);

                await LoadStoresAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    $"Failed to update store status. HTTP {(int)response.StatusCode}: {error}",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Error updating store status: {ex.Message}",
                Severity.Error);
        }
    }
}