@page "/users"

@using StoreManagement.Web.DTOs.Users
@using StoreManagement.Web.Components.Dialogs.Users
@using StoreManagement.Web.Services
@using MudBlazor

@inject ApiService ApiService
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Spacing="3">
        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h4">Users</MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="AddUser">
                Add User
            </MudButton>
        </MudStack>

        <MudTextField T="string"
                      @bind-Value="_search"
                      Placeholder="Search email, role, or store..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Clearable="true"
                      Variant="Variant.Outlined" />

        <MudCheckBox T="bool"
                     @bind-Value="_showInactive"
                     Label="Show inactive users"
                     Color="Color.Primary" />

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudTable Items="@FilteredUsers"
                      Hover="true"
                      Striped="true"
                      Dense="true">
                <HeaderContent>
                    <MudTh>Email</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Store</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Created</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Email">
                        @context.Email
                    </MudTd>

                    <MudTd DataLabel="Role">
                        @context.Role
                    </MudTd>

                    <MudTd DataLabel="Store">
                        @(context.StoreName ?? "All stores")
                    </MudTd>

                    <MudTd DataLabel="Status">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@(context.IsActive ? Color.Success : Color.Default)">
                            @(context.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="Created">
                        @context.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")
                    </MudTd>

                    <MudTd DataLabel="Actions">
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Title="Edit user"
                                           OnClick="@(() => EditUser(context))" />

                            <MudIconButton Icon="@Icons.Material.Filled.LockReset"
                                           Color="Color.Warning"
                                           Title="Reset password"
                                           OnClick="@(() => ResetPassword(context))" />

                            <MudIconButton Icon="@(context.IsActive
                                                                               ? Icons.Material.Filled.PersonOff
                                                                           : Icons.Material.Filled.Person)"
                                       Color="@(context.IsActive
                                                                           ? Color.Error
                                                                           : Color.Success)"
                                       Title="@(context.IsActive
                                                                           ? "Deactivate user"
                                                                           : "Activate user")"
                                       OnClick="@(() => ToggleStatus(context))" />
                    </MudStack>
                </MudTd>
            </RowTemplate>

                <NoRecordsContent>
                    <MudText Class="pa-4">No users found.</MudText>
                </NoRecordsContent>

                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
                }
    </MudStack>
</MudContainer>

@code {
    private List<UserDto> _users = new();
    private string _search = string.Empty;
    private bool _showInactive;
    private bool _loading = true;

    private IEnumerable<UserDto> FilteredUsers =>
        _users.Where(x =>
            (_showInactive || x.IsActive) &&
            (string.IsNullOrWhiteSpace(_search) ||
             x.Email.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             x.Role.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             (x.StoreName?.Contains(
                 _search, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (x.StoreCode?.Contains(
                 _search, StringComparison.OrdinalIgnoreCase) ?? false)));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await AuthState.InitializeAsync();

        if (string.IsNullOrWhiteSpace(AuthState.Token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadUsers();
        StateHasChanged();
    }

    private async Task LoadUsers()
    {
        _loading = true;

        try
        {
            var users = await ApiService.GetAsync<List<UserDto>>(
                "api/users?includeInactive=true");

            _users = users ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to load users: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddUser()
    {
        var parameters = new DialogParameters<UserDialog>();

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<UserDialog>(
            "Add User",
            parameters,
            options);

        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadUsers();
    }

    private async Task EditUser(UserDto user)
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { x => x.User, user }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<UserDialog>(
            "Edit User",
            parameters,
            options);

        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadUsers();
    }

    private async Task ToggleStatus(UserDto user)
    {
        var response = await ApiService.PatchAsync(
            $"api/users/{user.Id}/status",
            new UpdateUserStatusRequest
            {
                IsActive = !user.IsActive
            });

        if (response.IsSuccessStatusCode)
        {
            Snackbar.Add(
                user.IsActive ? "User deactivated." : "User activated.",
                Severity.Success);

            await LoadUsers();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();

            Snackbar.Add(
                $"Unable to update user status. {error}",
                Severity.Error);
        }
    }

    private async Task ResetPassword(UserDto user)
    {
        var parameters = new DialogParameters<ResetUserPasswordDialog>
        {
            { x => x.UserEmail, user.Email }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ResetUserPasswordDialog>(
            "Reset Password",
            parameters,
            options);

        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            var request = result.Data as ResetUserPasswordRequest;

            if (request is null)
                return;

            var response = await ApiService.PostAsync(
                $"api/users/{user.Id}/reset-password",
                request);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Password reset successfully.", Severity.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    $"Unable to reset password. {error}",
                    Severity.Error);
            }
        }
    }
}
