@using MudBlazor
@using StoreManagement.Web.DTOs.Brands
@namespace StoreManagement.Web.Components.Dialogs.Brands

<MudDialog>

    <DialogContent>

        <MudTextField T="string"
                      Label="Brand Name"
                      @bind-Value="_name"
                      Required="true"
                      RequiredError="Brand name is required."
                      Variant="MudBlazor.Variant.Outlined"
                      Immediate="true"
                      MaxLength="100"
                      AutoFocus="true" />

    </DialogContent>

    <DialogActions>

        <MudButton OnClick="Cancel"
                   Variant="MudBlazor.Variant.Text">
            Cancel
        </MudButton>

        <MudButton OnClick="Save"
                   Color="Color.Primary"
                   Variant="MudBlazor.Variant.Filled"
                   Disabled="@string.IsNullOrWhiteSpace(_name)">

            @(Brand is null ? "Add Brand" : "Save Changes")

        </MudButton>

    </DialogActions>

</MudDialog>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    // Null = Add mode
    // Has value = Edit mode
    [Parameter]
    public BrandDto? Brand { get; set; }

    private string _name = string.Empty;

    protected override void OnInitialized()
    {
        if (Brand is not null)
        {
            _name = Brand.Name;
        }
    }

    private void Save()
    {
        var name = _name.Trim();

        if (string.IsNullOrWhiteSpace(name))
            return;

        MudDialog.Close(
            DialogResult.Ok(
                new CreateBrandRequest
                {
                    Name = name
                }));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
