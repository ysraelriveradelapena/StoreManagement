@using System.Net.Http.Json
@using StoreManagement.Web.DTOs.Users
@using StoreManagement.Web.DTOs.Stores
@using StoreManagement.Web.Services
@using MudBlazor
@using System.ComponentModel.DataAnnotations
@inject ApiService ApiService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">
                    @(_isEdit ? "Edit User" : "Add User")
                </MudText>

                <MudTextField T="string"
                              Label="Email"
                              @bind-Value="_model.Email"
                              Required="true"
                              RequiredError="Email is required."
                              Validation="@(new EmailAddressAttribute())"
                              InputType="InputType.Email"
                              Disabled="_saving" />


                @if (!_isEdit)
                {
                    <MudTextField T="string"
                                  Label="Initial Password"
                                  @bind-Value="_password"
                                  Required="true"
                                  RequiredError="Password is required."
                                  InputType="InputType.Password"
                                  Validation="@(new Func<string, IEnumerable<string>>(ValidatePassword))"
                                  Disabled="_saving" />

                    <MudTextField T="string"
                                  Label="Confirm Password"
                                  @bind-Value="_confirmPassword"
                                  Required="true"
                                  RequiredError="Please confirm the password."
                                  InputType="InputType.Password"
                                  Validation="@(new Func<string, IEnumerable<string>>(ValidateConfirmPassword))"
                                  Disabled="_saving" />
                }


                <MudSelect T="string"
                           Label="Role"
                           @bind-Value="_model.Role"
                           Required="true"
                           RequiredError="Select a role."
                           Disabled="_saving || _roles.Count == 0">
                    @foreach (var role in _roles)
                    {
                        <MudSelectItem T="string" Value="@role">
                            @role
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="int?"
                           Label="Assigned Store"
                           @bind-Value="_model.StoreId"
                           Clearable="true"
                           Disabled="_saving">
                    @foreach (var store in _stores)
                    {
                        <MudSelectItem T="int?" Value="@((int?)store.Id)">
                            @store.StoreCode - @store.StoreName
                        </MudSelectItem>
                    }
                </MudSelect>

                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">
            Cancel
        </MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   Disabled="_saving || _loading">
            @(_saving ? "Saving..." : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public UserDto? User { get; set; }

    private MudForm _form = default!;
    private UserRequest _model = new();
    private string _password = string.Empty;

    private List<string> _roles = new();
    private List<StoreDto> _stores = new();

    private bool _isEdit;
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _isEdit = User is not null;

        if (User is not null)
        {
            _model = new UserRequest
            {
                Email = User.Email,
                Role = User.Role,
                StoreId = User.StoreId
            };
        }

        try
        {
            var roles = await ApiService.GetAsync<List<string>>(
                "api/users/roles");

            _roles = roles ?? new();

            var stores = await ApiService.GetAsync<List<StoreDto>>(
                "api/stores");

            _stores = stores?
                .Where(x => x.IsActive)
                .OrderBy(x => x.StoreName)
                .ToList() ?? new();

            if (_isEdit && !_roles.Contains(_model.Role))
            {
                _roles.Add(_model.Role);
            }
        }
        catch
        {
            Snackbar.Add(
                "Unable to load roles or stores.",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Save()
    {
        await _form.Validate();

        if (!_form.IsValid)
            return;

        if (!_isEdit && _password != _confirmPassword)
        {
            Snackbar.Add("Passwords do not match.", Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.Role))
        {
            Snackbar.Add("Please select a role.", Severity.Warning);
            return;
        }

        _saving = true;

        try
        {
            HttpResponseMessage response;

            if (_isEdit)
            {
                response = await ApiService.PutAsync(
                    $"api/users/{User!.Id}",
                    _model);
            }
            else
            {
                var request = new CreateUserRequest
                {
                    Email = _model.Email,
                    Role = _model.Role,
                    StoreId = _model.StoreId,
                    Password = _password
                };

                response = await ApiService.PostAsync(
                    "api/users",
                    request);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    _isEdit ? "User updated." : "User created.",
                    Severity.Success);

                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    $"Unable to save user. {error}",
                    Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"An error occurred: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private string _confirmPassword = string.Empty;

    private IEnumerable<string> ValidatePassword(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
            yield return "Password is required.";
        else if (password.Length < 6)
            yield return "Password must contain at least 6 characters.";
    }

    private IEnumerable<string> ValidateConfirmPassword(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
            yield return "Please confirm the password.";
        else if (password != _password)
            yield return "Passwords do not match.";
    }
}
