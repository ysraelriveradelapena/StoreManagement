```razor
@using System.Net
@using System.Text.Json
@using MudBlazor
@using StoreManagement.Web.DTOs.Devices
@using StoreManagement.Web.DTOs.Stores
@using StoreManagement.Web.Services

@inject ApiService ApiService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        @(IsEdit ? "Edit Device" : "Add Device")
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField T="string"
                          Label="Device Code"
                          @bind-Value="_request.Code"
                          Required="true"
                          RequiredError="Device code is required."
                          MaxLength="100"
                          Disabled="@IsEdit" />

            <MudTextField T="string"
                          Label="Device Name"
                          @bind-Value="_request.Name"
                          Required="true"
                          RequiredError="Device name is required."
                          MaxLength="100"
                          Class="mt-3" />

            <MudSelect T="int"
                       Label="Store"
                       @bind-Value="_request.StoreId"
                       Required="true"
                       RequiredError="Please select a store."
                       Class="mt-3">

                @foreach (var store in _stores)
                {
                    <MudSelectItem T="int" Value="@store.Id">
                        @store.StoreCode - @store.StoreName
                    </MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Disabled="@_saving">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   Disabled="@_saving">
            @(_saving ? "Saving..." : IsEdit ? "Save Changes" : "Add Device")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialogInstance { get; set; } = default!;

    [Parameter]
    public DeviceDto? Device { get; set; }

    private MudForm _form = default!;
    private DeviceRequest _request = new();
    private List<StoreDto> _stores = new();
    private bool _saving;

    private bool IsEdit => Device is not null;

    protected override async Task OnInitializedAsync()
    {
        if (Device is not null)
        {
            _request = new DeviceRequest
            {
                Code = Device.Code,
                Name = Device.Name,
                StoreId = Device.StoreId
            };
        }

        try
        {
            var result = await ApiService.GetAsync<List<StoreDto>>(
                "api/stores");

            _stores = result ?? new List<StoreDto>();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Failed to load stores: {ex.Message}",
                Severity.Error);
        }
    }

    private void Cancel()
    {
        MudDialogInstance.Cancel();
    }

    private async Task Save()
    {
        if (_saving)
            return;

        await _form.Validate();

        if (!_form.IsValid)
            return;

        _saving = true;

        try
        {
            HttpResponseMessage response;

            if (IsEdit)
            {
                response = await ApiService.PutAsync(
                    $"api/devices/{Device!.Id}",
                    _request);
            }
            else
            {
                response = await ApiService.PostAsync(
                    "api/devices",
                    _request);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    IsEdit
                        ? "Device updated successfully."
                        : "Device added successfully.",
                    Severity.Success);

                MudDialogInstance.Close(DialogResult.Ok(true));
                return;
            }

            var responseBody =
                await response.Content.ReadAsStringAsync();

            var errorMessage = FormatApiError(
                response.StatusCode,
                responseBody);

            Snackbar.Add(errorMessage, Severity.Error);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(
                $"Unable to connect to the API: {ex.Message}",
                Severity.Error);
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add(
                "The request timed out while saving the device. Please try again.",
                Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unexpected error while saving the device: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FormatApiError(
        HttpStatusCode statusCode,
        string responseBody)
    {
        var status = (int)statusCode;
        var body = responseBody?.Trim();

        if (string.IsNullOrWhiteSpace(body))
        {
            return statusCode switch
            {
                HttpStatusCode.Forbidden =>
                    "Unable to save device (403 Forbidden). Your account may not have permission to register devices.",

                HttpStatusCode.Unauthorized =>
                    "Unable to save device (401 Unauthorized). Please sign in again.",

                HttpStatusCode.BadRequest =>
                    "Unable to save device (400 Bad Request). Check the submitted device details.",

                HttpStatusCode.Conflict =>
                    "Unable to save device (409 Conflict). The device code may already exist.",

                _ =>
                    $"Unable to save device (HTTP {status} {statusCode}). The API returned no error details."
            };
        }

        try
        {
            using var document = JsonDocument.Parse(body);
            var root = document.RootElement;

            if (root.ValueKind == JsonValueKind.Object)
            {
                if (root.TryGetProperty("message", out var message) &&
                    message.ValueKind == JsonValueKind.String)
                {
                    return $"Unable to save device (HTTP {status}): {message.GetString()}";
                }

                if (root.TryGetProperty("title", out var title) &&
                    title.ValueKind == JsonValueKind.String)
                {
                    var titleText = title.GetString();

                    if (root.TryGetProperty("errors", out var errors))
                    {
                        return $"Unable to save device (HTTP {status}): {titleText}. {errors}";
                    }

                    return $"Unable to save device (HTTP {status}): {titleText}";
                }

                if (root.TryGetProperty("detail", out var detail) &&
                    detail.ValueKind == JsonValueKind.String)
                {
                    return $"Unable to save device (HTTP {status}): {detail.GetString()}";
                }
            }
        }
        catch (JsonException)
        {
            // The response is plain text rather than JSON.
        }

        return $"Unable to save device (HTTP {status}): {body}";
    }
}
