
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using StoreManagement.Web.DTOs.ProductVariants
@using MudBlazor
@using StoreManagement.Web.Services
@inject ApiService ApiService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="_request">
            <MudText Typo="Typo.h6" Class="mb-1">
                @(_isEdit ? "Edit Variant" : "Add Variant")
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                Product: @_productName
            </MudText>

            <MudTextField T="string"
                          Label="SKU"
                          @bind-Value="_request.SKU"
                          Required="true"
                          RequiredError="SKU is required."
                          MaxLength="50"
                          Variant="@MudBlazor.Variant.Outlined"
                          Margin="Margin.Dense" />

            <MudTextField T="string"
                          Label="Barcode"
                          @bind-Value="_request.Barcode"
                          MaxLength="100"
                          Variant="@MudBlazor.Variant.Outlined"
                          Margin="Margin.Dense" />

            <MudTextField T="string"
                          Label="Variant Name"
                          @bind-Value="_request.VariantName"
                          MaxLength="100"
                          Variant="@MudBlazor.Variant.Outlined"
                          Margin="Margin.Dense" />

            <MudGrid>
                <MudItem xs="6">
                    <MudTextField T="string"
                                  Label="Size"
                                  @bind-Value="_request.Size"
                                  MaxLength="50"
                                  Variant="@MudBlazor.Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField T="string"
                                  Label="Color"
                                  @bind-Value="_request.Color"
                                  MaxLength="50"
                                  Variant="@MudBlazor.Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel"
                   Disabled="_saving">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="@MudBlazor.Variant.Filled"
                   OnClick="Save"
                   Disabled="_saving">
            @(_saving ? "Saving..." : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int ProductId { get; set; }

    [Parameter]
    public string ProductName { get; set; } = string.Empty;

    [Parameter]
    public ProductVariantDto? Variant { get; set; }

    private MudForm _form = default!;
    private ProductVariantRequest _request = new();
    private bool _isEdit;
    private bool _saving;
    private string _productName = string.Empty;

    protected override void OnInitialized()
    {
        _isEdit = Variant != null;
        _productName = ProductName;

        _request = new ProductVariantRequest
        {
            ProductId = ProductId,
            SKU = Variant?.SKU ?? string.Empty,
            Barcode = Variant?.Barcode,
            VariantName = Variant?.VariantName,
            Size = Variant?.Size,
            Color = Variant?.Color
        };
    }

    private async Task Save()
    {
        if (_saving)
            return;

        await _form.Validate();

        if (!_form.IsValid)
            return;

        if (_request.ProductId <= 0)
        {
            Snackbar.Add("A valid product is required.", Severity.Error);
            return;
        }

        _saving = true;

        try
        {
            HttpResponseMessage response;

            if (_isEdit)
            {
                response = await ApiService.PutAsync(
                    $"api/product-variants/{Variant!.Id}",
                    _request);
            }
            else
            {
                response = await ApiService.PostAsync(
                    "api/product-variants",
                    _request);
            }

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(
                    _isEdit ? "Variant updated." : "Variant created.",
                    Severity.Success);

                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            var error = await response.Content.ReadAsStringAsync();

            Snackbar.Add(
                string.IsNullOrWhiteSpace(error)
                    ? "Unable to save variant."
                    : error,
                Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving variant: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}