@inherits LayoutComponentBase
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@using StoreManagement.Web.Services
@using StoreManagement.Web.DTOs.Devices

@inject AuthService AuthService
@inject AuthState AuthState
@inject ApiService ApiService
@inject NavigationManager Navigation
@inject ILogger<MainLayout> Logger

<MudThemeProvider Theme="_theme" IsDarkMode="true" />

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="1" Color="Color.Dark">

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToggleDrawer" />

        <MudText Typo="Typo.h6">Store Management</MudText>

        <MudSpacer />

        <MudBadge Content="@_pendingDeviceRequests"
                  Color="Color.Error"
                  Visible="@(_pendingDeviceRequests > 0)"
                  Overlap="true">

            <MudIconButton Icon="@Icons.Material.Filled.Notifications"
                           Color="Color.Inherit"
                           Title="@GetNotificationTitle()"
                           OnClick="OpenDeviceRegistrationRequests" />

        </MudBadge>

        <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />

        <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                 Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight">

            <MudMenuItem Disabled="true">
                <MudText Typo="Typo.body2">
                    @GetUserName()
                </MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @GetUserRole()
                </MudText>
            </MudMenuItem>

            <MudDivider />

            <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                         OnClick="Logout">
                Logout
            </MudMenuItem>

        </MudMenu>

    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               Elevation="2"
               Color="Color.Dark"
               ClipMode="DrawerClipMode.Always">

        <MudNavMenu>

            <MudText Typo="Typo.overline"
                     Class="px-4 mt-4 mb-2"
                     Color="Color.Secondary">
                OVERVIEW
            </MudText>

            <MudNavLink Href="/home"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>

            <MudDivider Class="my-2" />

            <MudText Typo="Typo.overline"
                     Class="px-4 mt-4 mb-2"
                     Color="Color.Secondary">
                CATALOG
            </MudText>

            <MudNavLink Href="/products"
                        Icon="@Icons.Material.Filled.Inventory2">
                Products
            </MudNavLink>

            <MudNavLink Href="/brands"
                        Icon="@Icons.Material.Filled.Category">
                Brands
            </MudNavLink>

            <MudNavLink Href="/categories"
                        Icon="@Icons.Material.Filled.Folder">
                Categories
            </MudNavLink>

            <MudNavLink Href="/reason-codes"
                        Icon="@Icons.Material.Filled.Rule">
                Reason Codes
            </MudNavLink>

            <MudDivider Class="my-2" />

            <MudText Typo="Typo.overline"
                     Class="px-4 mt-4 mb-2"
                     Color="Color.Secondary">
                INVENTORY
            </MudText>

            <MudNavLink Href="/inventory"
                        Icon="@Icons.Material.Filled.Warehouse">
                Inventory
            </MudNavLink>

            <MudNavLink Href="/receiving"
                        Icon="@Icons.Material.Filled.MoveToInbox">
                Receiving
            </MudNavLink>

            <MudNavLink Href="/adjustments"
                        Icon="@Icons.Material.Filled.Tune">
                Adjustments
            </MudNavLink>

            <MudNavLink Href="/transfers"
                        Icon="@Icons.Material.Filled.SwapHoriz">
                Transfers
            </MudNavLink>

            <MudDivider Class="my-2" />

            <MudText Typo="Typo.overline"
                     Class="px-4 mt-4 mb-2"
                     Color="Color.Secondary">
                SALES
            </MudText>

            <MudNavLink Href="/sales"
                        Icon="@Icons.Material.Filled.PointOfSale">
                Sales
            </MudNavLink>

            <MudNavLink Href="/returns"
                        Icon="@Icons.Material.Filled.AssignmentReturn">
                Returns
            </MudNavLink>

            <MudDivider Class="my-2" />

            <MudText Typo="Typo.overline"
                     Class="px-4 mt-4 mb-2"
                     Color="Color.Secondary">
                REPORTS
            </MudText>

            <MudNavLink Href="/reports"
                        Icon="@Icons.Material.Filled.Assessment">
                Reports
            </MudNavLink>

            <MudNavLink Href="/audit"
                        Icon="@Icons.Material.Filled.History">
                Audit
            </MudNavLink>

            <MudDivider Class="my-2" />

            <MudText Typo="Typo.overline"
                     Class="px-4 mt-4 mb-2"
                     Color="Color.Secondary">
                ADMINISTRATION
            </MudText>

            <MudNavLink Href="/users"
                        Icon="@Icons.Material.Filled.People">
                Users
            </MudNavLink>

            <MudNavLink Href="/stores"
                        Icon="@Icons.Material.Filled.Store">
                Stores
            </MudNavLink>

            <MudNavLink Href="/devices"
                        Icon="@Icons.Material.Filled.Devices">
                Devices
            </MudNavLink>

            <MudNavLink Href="/device-registration-requests"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Approval">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween"
                          Spacing="2">

                    <MudText Typo="Typo.body2">
                        Device Registration Requests
                    </MudText>

                    @if (_pendingDeviceRequests > 0)
                    {
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="Color.Error"
                                 Variant="Variant.Filled">
                            @_pendingDeviceRequests
                        </MudChip>
                    }

                </MudStack>

            </MudNavLink>

        </MudNavMenu>

    </MudDrawer>

    <MudMainContent>
        <div class="store-page-container">
            @Body
        </div>
    </MudMainContent>

</MudLayout>

@code {
    private bool _drawerOpen = true;

    private int _pendingDeviceRequests;

    private readonly CancellationTokenSource _pollingCancellation = new();

    private Task? _pollingTask;

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#6366F1",
            Secondary = "#8B5CF6",
            Background = "#0F1117",
            Surface = "#151821",
            DrawerBackground = "#11131A",
            DrawerText = "#D1D5DB",
            AppbarBackground = "#151821",
            AppbarText = "#FFFFFF",
            TextPrimary = "#F9FAFB",
            TextSecondary = "#9CA3AF",
            ActionDefault = "#9CA3AF",
            Divider = "#252936"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshPendingDeviceRequestsAsync();

        _pollingTask = PollPendingDeviceRequestsAsync();
    }

    private async Task PollPendingDeviceRequestsAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(
                TimeSpan.FromSeconds(30));

            while (await timer.WaitForNextTickAsync(
                _pollingCancellation.Token))
            {
                await RefreshPendingDeviceRequestsAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Normal when the layout is disposed.
        }
    }

    private async Task RefreshPendingDeviceRequestsAsync()
    {
        try
        {
            var requests =
                await ApiService.GetAsync<List<DeviceRegistrationRequestDto>>(
                    "api/device-registration-requests?status=Pending");

            var newCount = requests?.Count ?? 0;

            if (newCount != _pendingDeviceRequests)
            {
                _pendingDeviceRequests = newCount;

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Ignore cancellation during shutdown.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                ex,
                "Unable to refresh pending device registration requests.");
        }
    }

    private string GetNotificationTitle()
    {
        return _pendingDeviceRequests == 1
            ? "1 pending device registration request"
            : $"{_pendingDeviceRequests} pending device registration requests";
    }

    private void OpenDeviceRegistrationRequests()
    {
        Navigation.NavigateTo("/device-registration-requests");
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private string GetUserName()
    {
        return AuthState.CurrentUser?.UserName ?? "Guest";
    }

    private string GetUserRole()
    {
        return AuthState.CurrentUser?.Roles?.FirstOrDefault() ?? "User";
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();

        AuthState.NotifyAuthenticationStateChanged();

        Navigation.NavigateTo("/login");
    }

    public async ValueTask DisposeAsync()
    {
        await _pollingCancellation.CancelAsync();

        if (_pollingTask is not null)
        {
            await _pollingTask;
        }

        _pollingCancellation.Dispose();
    }
}
